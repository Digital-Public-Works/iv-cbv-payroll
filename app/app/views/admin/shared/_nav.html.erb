<% content_for(:title, t("admin.shared.nav.brand")) unless content_for?(:title) %>
<div class="border-bottom border-base-lighter padding-bottom-2 margin-bottom-4">
  <div class="display-flex flex-align-center flex-justify flex-wrap">
    <div>
      <p class="font-heading-lg text-bold text-accent-warm margin-y-0"><%= t("admin.shared.nav.brand") %></p>
      <% if selected_agency_id.present? %>
        <p class="margin-y-0 text-base">
          <%= t("admin.shared.nav.agency_label") %>: <%= selected_agency_id.titleize %>
        </p>
      <% end %>
    </div>

    <% if selected_agency_id.present? %>
      <%= link_to t("admin.shared.nav.new_invitation"), new_admin_invitation_path, class: "usa-button" %>
    <% end %>
  </div>
</div>
