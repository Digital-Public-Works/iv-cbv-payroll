
<h1><%= t(".header") %></h1>
<p class="usa-intro"><%= t(".description") %></p>

<ul class="usa-list">
  <% @agencies.each do |agency| %>
    <li>
      <%= link_to agency.id.titleize,
            admin_root_url(host: "#{agency.agency_domain}.#{ENV["DOMAIN_NAME"]}"),
            class: "usa-link" %>
    </li>
  <% end %>
</ul>

<% if @agencies.empty? %>
  <p><%= t(".empty") %></p>
<% end %>
