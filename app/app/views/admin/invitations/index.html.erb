
<h1><%= t(".header") %></h1>
<p><%= t(".description", agency: agency_translation_for(selected_agency, "shared.agency_full_name")) %></p>

<table class="usa-table usa-table--striped width-full">
  <caption class="usa-sr-only"><%= t(".table_caption") %></caption>
  <thead>
    <tr>
      <th scope="col"><%= t(".column_created_at") %></th>
      <th scope="col"><%= t(".column_identifier") %></th>
      <th scope="col"><%= t(".column_channel") %></th>
      <th scope="col"><%= t(".column_destination") %></th>
      <th scope="col"><%= t(".column_status") %></th>
      <th scope="col"><span class="usa-sr-only"><%= t(".column_actions") %></span></th>
    </tr>
  </thead>
  <tbody>
    <% if @invitations.empty? %>
      <tr>
        <td colspan="6" class="text-center text-base"><%= t(".empty") %></td>
      </tr>
    <% end %>
    <% @invitations.each do |invitation| %>
        <% communication = invitation.invitation_communications.max_by(&:created_at) %>
        <tr>
          <td><%= invitation.created_at.in_time_zone(selected_agency.timezone.presence || "America/New_York").strftime("%b %-d, %-l:%M %p %Z") %></td>
          <td><%= invitation.cbv_applicant&.partner_identifier %></td>
          <td><%= communication ? t(".channel_#{communication.channel}") : t(".channel_link") %></td>
          <td>
            <% if communication&.channel_sms? && invitation.phone_number.present? %>
              <span aria-label="<%= t(".phone_ending_in", last_4: invitation.phone_number_last_4) %>">
                ···<%= invitation.phone_number_last_4 %>
              </span>
            <% elsif communication&.channel_email? && invitation.email_address.present? %>
              <span aria-label="<%= t(".email_at_domain", domain: invitation.email_address.split("@").last) %>">
                @<%= invitation.email_address.split("@").last %>
              </span>
            <% end %>
          </td>
          <td><%= communication ? t(".status_#{communication.status}") : t(".status_none") %></td>
          <td><%= link_to t(".view"), admin_invitation_path(id: invitation.id), class: "usa-link" %></td>
        </tr>
      <% end %>
  </tbody>
</table>
