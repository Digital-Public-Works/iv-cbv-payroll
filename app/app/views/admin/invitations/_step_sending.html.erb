<li class="usa-process-list__item" id="invitation_step_sending">
  <% in_progress = communication.status_created? || communication.status_sending? %>
  <h3 class="usa-process-list__heading <%= "display-flex flex-align-center" if in_progress %>">
    <% if in_progress %>
      <svg class="usa-icon rotate margin-right-05" aria-hidden="true" focusable="false" role="img">
        <use href="<%= asset_path("@uswds/uswds/dist/img/sprite.svg#autorenew") %>"></use>
      </svg>
    <% end %>
    <%= t("admin.invitations.status.sending_heading_#{communication.channel}") %>
  </h3>
  <p class="margin-top-05">
    <% if communication.status_created? %>
      <%= t("admin.invitations.status.sending_queued") %>
    <% elsif communication.status_sending? %>
      <%= t("admin.invitations.status.sending_in_progress") %>
    <% else %>
      <%= t("admin.invitations.status.sending_done") %>
    <% end %>
  </p>
  <p><%= t("admin.invitations.status.preview_intro") %></p>
  <div class="usa-summary-box bg-base-lightest maxw-tablet" role="region" aria-labelledby="message-preview-heading">
    <div class="usa-summary-box__body">
      <h4 class="usa-summary-box__heading" id="message-preview-heading">
        <%= t("admin.invitations.status.preview_heading") %>
      </h4>
      <div class="usa-summary-box__text">
        <%= simple_format(communication_preview(invitation, communication)) %>
      </div>
    </div>
  </div>
</li>
