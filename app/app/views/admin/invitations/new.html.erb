<%= render "admin/shared/nav" %>

<h1><%= t(".header") %></h1>
<p><%= t(".agency_note", agency: selected_agency_id.titleize) %></p>
<p class="usa-hint"><%= t(".required_note_html", abbr: usa_required_abbr) %></p>

<%= uswds_form_with(model: @cbv_flow_invitation, url: admin_invitations_path,
      data: {
        controller: "communication-channel",
        action: "input->communication-channel#update change->communication-channel#update"
      }) do |f| %>
  <% cbv_applicant = @cbv_flow_invitation.cbv_applicant ||
       @cbv_flow_invitation.build_cbv_applicant(client_agency_id: selected_agency_id) %>
  <% agency = selected_agency %>

  <%= f.fields_for :cbv_applicant, cbv_applicant do |f2| %>
    <% agency.applicant_attributes.select { |_, attr| attr.show_on_caseworker_form }.each do |name, attr| %>
      <% field_label = agency_translation("caseworker.cbv_flow_invitations.{agency}.invite.#{name}") %>
      <% field_label = safe_join([ field_label, " ", usa_required_abbr ]) if attr.required %>
      <% required_data = attr.required ? { required: true } : {} %>
      <% case attr.form_field_type %>
      <% when "memorable_date" %>
        <%= f2.memorable_date name.to_sym, legend: field_label %>
      <% when "date_picker" %>
        <%= f2.date_picker name.to_sym, label: field_label, data: required_data %>
      <% else %>
        <%= f2.text_field name.to_sym, label: field_label, data: required_data %>
      <% end %>
    <% end %>
  <% end %>

  <div class="usa-form-group <%= "usa-form-group--error" if f.field_error(:language).present? %>">
    <legend class="usa-legend"><%= t(".language_legend") %> <%= usa_required_abbr %></legend>
    <%= f.field_error :language %>
    <div class="usa-radio-group">
      <% language_options.each_with_index do |(value, label), index| %>
        <div class="usa-radio usa-radio--tile">
          <input
            class="usa-radio__input usa-radio__input--tile"
            id="language-<%= value %>-<%= index %>"
            type="radio"
            name="<%= f.object_name %>[language]"
            value="<%= value %>"
            <%= 'checked="checked"' if f.object.language == value %>
          >
          <label class="usa-radio__label" for="language-<%= value %>-<%= index %>">
            <%= label %>
          </label>
        </div>
      <% end %>
    </div>
  </div>

  <div class="usa-form-group">
    <legend class="usa-legend"><%= t(".channel_legend") %> <%= usa_required_abbr %></legend>
    <div class="usa-radio-group">
      <% Admin::InvitationsController::FORM_CHANNELS.each do |channel| %>
        <div class="usa-radio usa-radio--tile">
          <input
            class="usa-radio__input usa-radio__input--tile"
            id="communication-channel-<%= channel %>"
            type="radio"
            name="<%= f.object_name %>[communication_channel]"
            value="<%= channel %>"
            <%= 'checked="checked"' if f.object.communication_channel == channel %>
          >
          <label class="usa-radio__label" for="communication-channel-<%= channel %>">
            <%= t(".channel_#{channel}") %>
            <span class="usa-checkbox__label-description"><%= t(".channel_#{channel}_description") %></span>
          </label>
        </div>
      <% end %>
    </div>

    <div data-communication-channel-target="channelFields" data-channel="sms" hidden>
      <div class="usa-form-group <%= "usa-form-group--error" if f.field_error(:phone_number).present? %>">
        <label class="usa-label" for="cbv_flow_invitation_phone_number">
          <%= t(".phone_label") %> <%= usa_required_abbr %>
        </label>
        <p class="usa-hint margin-top-0" id="phone-number-hint"><%= t(".phone_hint") %></p>
        <%= f.field_error :phone_number %>
        <input
          class="usa-input"
          type="tel"
          id="cbv_flow_invitation_phone_number"
          name="<%= f.object_name %>[phone_number]"
          aria-describedby="phone-number-hint"
          autocomplete="off"
          data-required="true"
          value="<%= f.object.phone_number %>"
        >
      </div>

      <div class="usa-checkbox margin-top-2">
        <input
          class="usa-checkbox__input"
          id="sms_attestation"
          type="checkbox"
          name="sms_attestation"
          value="1"
          data-required="true"
        >
        <label class="usa-checkbox__label" for="sms_attestation">
          <%= t(".attestation_label") %> <%= usa_required_abbr %>
        </label>
      </div>
    </div>

    <div data-communication-channel-target="channelFields" data-channel="email" hidden>
      <div class="usa-form-group <%= "usa-form-group--error" if f.field_error(:email_address).present? %>">
        <label class="usa-label" for="cbv_flow_invitation_email_address">
          <%= t(".email_label") %> <%= usa_required_abbr %>
        </label>
        <p class="usa-hint margin-top-0" id="email-address-hint"><%= t(".email_hint") %></p>
        <%= f.field_error :email_address %>
        <input
          class="usa-input"
          type="email"
          id="cbv_flow_invitation_email_address"
          name="<%= f.object_name %>[email_address]"
          aria-describedby="email-address-hint"
          autocomplete="off"
          data-required="true"
          value="<%= f.object.email_address %>"
        >
      </div>
    </div>
  </div>

  <%= f.submit t(".submit_link"),
        disabled: true,
        data: {
          communication_channel_target: "submit",
          label_link: t(".submit_link"),
          label_sms: t(".submit_sms"),
          label_email: t(".submit_email")
        } %>
<% end %>
