<h1>
  <%= @communication ? t(".header_#{@communication.channel}") : t(".header") %>
</h1>

<% if @communication %>
  <h2><%= t(".status_header_#{@communication.channel}") %></h2>
  <%# Polling replaces only the two dynamic steps, so the copy-link state in
      step 1 survives each refresh. %>
  <div
    aria-live="polite"
    data-controller="polling"
    data-polling-url-value="<%= status_admin_invitation_path(id: @invitation.id) %>"
  >
    <ol class="usa-process-list">
      <li class="usa-process-list__item">
        <h3 class="usa-process-list__heading"><%= t("admin.invitations.status.created_heading") %></h3>
        <p class="margin-top-05"><%= t(".created_body_1") %></p>
        <p><%= t(".created_body_2_#{@communication.channel}") %></p>
        <%= render "invitation_link", invitation: @invitation %>
      </li>
      <%= render "step_sending", invitation: @invitation, communication: @communication %>
      <%= render "step_result", invitation: @invitation, communication: @communication %>
    </ol>
  </div>
<% else %>
  <p><%= t(".created_body_1") %></p>
  <div class="margin-bottom-4">
    <%= render "invitation_link", invitation: @invitation %>
  </div>
<% end %>

<div class="margin-top-4">
  <%= link_to t(".create_another"), new_admin_invitation_path, class: "usa-button usa-button--outline" %>
  <%= link_to t(".view_invitations"), admin_invitations_path, class: "usa-button usa-button--outline" %>
</div>
