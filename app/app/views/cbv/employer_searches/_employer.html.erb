<%= turbo_frame_tag "employers" do %>
  <% if @show_unemployment_tips %>
    <%= render partial: "unemployment_search_tips" %>
  <% end %>

  <% if @query.present? %>
    <h2 class="site-preview-heading margin-bottom-2" data-cbv-employer-search-target="resultsHeading">
      <%= t("cbv.employer_searches.show.results", result_count: @employers.count) %>
    </h2>
    <p><%= t("cbv.employer_searches.show.select_item_instruction") %></p>
  <% end %>
  <ul class="usa-card-group">
    <% @employers.each do |employer| %>
      <li class="usa-card usa-card--flag desktop:grid-col-6">
        <div class="usa-card__container">
          <div class="usa-card__header">
            <h3 class="usa-card__heading"><%= employer.name %></h3>
          </div>
          <% if employer.logo_url.present? %>
            <div class="usa-card__media usa-card__media--inset display-flex flex-justify-center">
              <div class="usa-card__img cbv-employer-card__img">
                <%# alt is intentionally blank to mark this as a decorative image %>
                <img
                  src="<%= employer.logo_url.sub(/^http:/, "https:") %>"
                  alt=""
                >
              </div>
            </div>
          <% end %>
          <div class="usa-card__footer">
            <button
              data-action="click->cbv-employer-search#select"
              data-id="<%= employer.provider_options.provider_id %>"
              data-response-type="<%= employer.provider_options.response_type %>"
              data-is-default-option="false"
              data-name="<%= employer.name %>"
              data-cbv-employer-search-target="employerButton"
              data-provider-name="<%= employer.provider_name %>"
              class="usa-button usa-button--outline"
              type="button"
            >
              <%= t("cbv.employer_searches.show.select") %>
              <%= sr_only_span(employer.name) %>
            </button>
          </div>
        </div>
      </li>
    <% end %>
  </ul>

  <% if @query.present? %>
    <div class="margin-top-5" data-controller="click-tracker" data-click-tracker-page-value="employer_search">
      <h2 class="margin-bottom-2"><%= t("cbv.employer_searches.show.employer_not_listed") %></h2>
      <ul class="usa-button-group">
        <li>
          <%= link_to cbv_flow_missing_results_path, class: "usa-button usa-button--outline", data: { turbo_frame: "_top", action: "click->click-tracker#track", element_type: ClickTracker::ElementType::InternalLink, element_name: "cannot_find_employer", track_event: TrackEvent::ApplicantClickedCannotFindEmployer } do %>
            <%= t("cbv.employer_searches.show.can_not_find_employer") %>
          <% end %>
        </li>
      <% if @employers.count >= 5 %>
          <li>
            <button
              href="#query"
              class="usa-button"
              type="button"
              data-controller="anchor-scroll"
              data-action="click->anchor-scroll#scroll">
              <svg class="usa-icon" aria-hidden="true" focusable="false" role="img">
                <use href="<%= asset_path("@uswds/uswds/dist/img/sprite.svg#expand_less") %>"></use>
              </svg>
              <%= t("cbv.employer_searches.show.back_to_top") %>
            </button>
          </li>
      <% end %>
      </ul>
    </div>

    <hr class="margin-y-5 border-base-light border-top-0" >
  <% end %>
<% end %>
