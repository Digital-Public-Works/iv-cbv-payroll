<div class="grid-row" id="<%= dom_id payroll_account %>">
  <div class="desktop:grid-col-2 tablet:grid-col-fill">
    <%= render partial: "cbv/synchronizations/indicator", locals: { id: "identity", label: t(".identity"), status: coalesce_to_completed(payroll_account.job_status("identity")) } %>
  </div>
  <div class="desktop:grid-col-2 tablet:grid-col-fill">
    <%= render partial: "cbv/synchronizations/indicator", locals: { id: "income", label: t(".income"), status: coalesce_to_completed(payroll_account.job_status("income")) } %>
  </div>
  <div class="desktop:grid-col-2 tablet:grid-col-fill">
    <%= render partial: "cbv/synchronizations/indicator", locals: { id: "employment", label: t(".employment"), status: coalesce_to_completed(payroll_account.job_status("employment")) } %>
  </div>
  <div class="desktop:grid-col-2 tablet:grid-col-fill">
    <%= render partial: "cbv/synchronizations/indicator", locals: { id: "paystubs", label: t(".paystubs"), status: paystubs_indicator_status(payroll_account) } %>
  </div>
</div>
