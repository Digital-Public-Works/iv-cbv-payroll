<%= tag.table(**@attributes.merge(class: @class_names)) do %>
  <% if header.present? || subheader_row.present? %>
    <thead class="<%= @thead_class_names %>">
      <% if header.present? %>
        <tr>
          <%= header %>
        </tr>
      <% end %>
      <% if subheader_row.present? %>
        <%= subheader_row %>
      <% end %>
    </thead>
  <% end %>
  <tbody>
    <% rows.each do |row| %>
      <%= row %>
    <% end %>
  </tbody>
<% end %>
