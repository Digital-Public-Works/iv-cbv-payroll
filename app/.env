# ##############################################################################
# Default values for application configuration
# ##############################################################################
SANDBOX_PINWHEEL_ENVIRONMENT=sandbox
MAINTENANCE_MODE=false

ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=primary
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=deterministic
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=derivationsalt
SUPPORTED_PROVIDERS=argyle

DOMAIN_NAME=localhost

PINWHEEL_API_TOKEN_SANDBOX=API secret
ARGYLE_SANDBOX_WEBHOOK_SECRET=Webhook Secret
SLACK_TEST_EMAIL=test@email.com

# ##############################################################################
# Optional configuration for development. Override these in your `.env.local`.
# ##############################################################################
# By default, we use the `wkhtmltopdf-binary` gem to distribute the wkhtmltopdf
# binary for cross-environment version consistency. Set this to "true" to
# instead use the binary installed by your system package manager. (Note that
# we've seen minor visual discrepancies in the page headers/footers across
# different versions of wkhtmltopdf.)
USE_SYSTEM_WKHTMLTOPDF=false

MISSION_CONTROL_USER=user
MISSION_CONTROL_PASSWORD=password

# development mixpanel token
MIXPANEL_TOKEN=12311d1545928e381e9186818baf03e3

# AWS SNS (SMS invitations). Set real values in .env.local. Only needed for the
# SMS path; link-only invitations work without them.
#
# The AWS_* credentials further down are Moto placeholders for local SQS, so SNS
# needs its own credentials to reach AWS. Two ways to supply them:
#
#   1. AWS_SNS_PROFILE (preferred) — the name of an SSO profile from ~/.aws/config,
#      e.g. "demo". Run `aws sso login --profile demo` first. No long-lived key ends
#      up on the machine; see docs/infra/set-up-infrastructure-tools.md.
#   2. AWS_SNS_ACCESS_KEY_ID + AWS_SNS_SECRET_ACCESS_KEY — static keys for an IAM
#      user, if SSO is not an option.
#
# A profile wins if both are set. Setting neither falls back to the default AWS
# chain, which is what a deployed task role uses. Either way the identity needs a
# single permission: sns:Publish on "*".
#
# AWS_SNS_REGION defaults to AWS_REGION when unset. SMS is region-scoped, so it
# must be the region where the account's SMS settings and origination numbers live.
#
# NOTE: while the account is in the SNS SMS sandbox, sends only succeed to
# destination numbers verified in the SNS console; anything else comes back as a
# permanent failure on the invitation.

# Required for real sends. Fill these in (preferably in .env.local, which is
# gitignored — this file is tracked).
AWS_SNS_PROFILE=Profile Name
AWS_SNS_REGION=Region Name

# Alternative to AWS_SNS_PROFILE: static IAM user keys. Uncomment both only if you
# are not using an SSO profile — a profile takes precedence over them.
# AWS_SNS_ACCESS_KEY_ID=
# AWS_SNS_SECRET_ACCESS_KEY=

# Optional — leave commented unless you have one. A placeholder value here is
# worse than an absent one: it is sent to SNS as a message attribute and the
# send fails with InvalidParameter.
# AWS_SNS_ORIGINATION_NUMBER=

# Optional — seconds to wait between the opt-in notice and the invitation so they
# arrive in order (default 8). The notice is 2 segments and the invitation 1, so
# the notice needs a real head start. Raise it if they still land out of order;
# set it to 0 to send back to back.
# SMS_INTER_MESSAGE_DELAY_SECONDS=8

# Optional — set to http://localhost:3456 to exercise the flow against Moto
# without sending a real text. Leave commented to reach real AWS.
# AWS_SNS_ENDPOINT=

# Twilio (SMS invitations) — CURRENTLY UNUSED. Invitations go out over AWS SNS
# (above); TwilioSmsService is retained in case we revisit Twilio, which offers
# delivery callbacks and synchronous opt-out reporting that SNS does not. If it
# is re-enabled: set EITHER a Messaging Service SID (starts with "MG"; the
# production setup) OR, simplest for a trial account, TWILIO_FROM_NUMBER = your
# Twilio trial phone number in E.164 (+1...).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_MESSAGING_SERVICE_SID=
# TWILIO_FROM_NUMBER=

# Optional dev-only SMTP delivery for invitation emails (set in .env.local).
# Works with Mailtrap, MailHog (SMTP_HOST=localhost SMTP_PORT=1025
# SMTP_STARTTLS=false, no auth), or a Gmail app password. Unset = emails are
# "sent" but go nowhere. Production uses the SES v2 API instead.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_STARTTLS=true

# for shoryuken - local dev
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1
AWS_SQS_ENDPOINT=http://localhost:3456
SHORYUKEN_LOGLEVEL=info

AWS_SDK_LOAD_CONFIG=false
