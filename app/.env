# ##############################################################################
# Default values for application configuration
# ##############################################################################
SANDBOX_PINWHEEL_ENVIRONMENT=sandbox
MAINTENANCE_MODE=false

ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=primary
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=deterministic
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=derivationsalt
SUPPORTED_PROVIDERS=argyle

DOMAIN_NAME=localhost

PINWHEEL_API_TOKEN_SANDBOX=API secret
ARGYLE_SANDBOX_WEBHOOK_SECRET=Webhook Secret
SLACK_TEST_EMAIL=test@email.com

# ##############################################################################
# Optional configuration for development. Override these in your `.env.local`.
# ##############################################################################
# By default, we use the `wkhtmltopdf-binary` gem to distribute the wkhtmltopdf
# binary for cross-environment version consistency. Set this to "true" to
# instead use the binary installed by your system package manager. (Note that
# we've seen minor visual discrepancies in the page headers/footers across
# different versions of wkhtmltopdf.)
USE_SYSTEM_WKHTMLTOPDF=false

MISSION_CONTROL_USER=user
MISSION_CONTROL_PASSWORD=password

# Partner-config admin API (/api/admin/v1), used by the vmi-admin portal. It is
# off unless ADMIN_API_SERVICE_SECRET is set; use the same value as the
# portal's .env.local. ADMIN_API_SETTINGS_WRITABLE must be "true" for settings
# edits (as in demo); unset means read-only settings (as in prod). To run a
# second local VMI that stands in for prod, with its own database:
#   DB_NAME=iv_cbv_payroll_development_prod bin/rails db:prepare
#   DB_NAME=iv_cbv_payroll_development_prod ADMIN_API_SETTINGS_WRITABLE=false bin/rails server -p 3001
ADMIN_API_SERVICE_SECRET=local-admin-api-secret
ADMIN_API_SETTINGS_WRITABLE=true

# development mixpanel token
MIXPANEL_TOKEN=12311d1545928e381e9186818baf03e3

# for shoryuken - local dev
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1
AWS_SQS_ENDPOINT=http://localhost:3456
SHORYUKEN_LOGLEVEL=info

AWS_SDK_LOAD_CONFIG=false
